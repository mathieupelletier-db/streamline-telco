{
  "name": "streamline-care-desk",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "appkit generate-types || true",
    "typegen": "appkit generate-types || true",
    "db:generate": "drizzle-kit generate",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsdown --config tsdown.server.config.ts",
    "build:local": "npm run build:client && npm run build:server",
    "build:source": "echo '[build:source] no-op on container — dist/ + client/dist/ ship prebuilt'",
    "build": "npm run build:source",
    "predev": "npm run db:generate",
    "dev": "tsx watch server/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@databricks/appkit": "0.66.1",
    "@databricks/appkit-ui": "0.66.1",
    "@openai/agents": "^0.17.0",
    "drizzle-orm": "^0.45.0",
    "express": "^4.21.0",
    "jsonc-parser": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "mlflow-tracing": "^0.1.3",
    "openai": "^7.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.0",
    "react-router": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}

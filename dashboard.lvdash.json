              "frame": {"title": "Plan", "showTitle": true},
              "encodings": {"fields": [
                {"fieldName": "plan_type", "queryName": "q_plan_exp", "displayName": "Plan"},
                {"fieldName": "plan_type", "queryName": "q_plan_sub"}
              ]}
            }
          },
          "position": {"x": 0, "y": 0, "width": 4, "height": 2}
        },
        {
          "widget": {
            "name": "filter_reason",
            "queries": [
              {"name": "q_reason_exp", "query": {"datasetName": "ds_exposure", "fields": [{"name": "churn_reason", "expression": "`churn_reason`"}], "disaggregated": false}},
              {"name": "q_reason_sub", "query": {"datasetName": "ds_subscribers", "fields": [{"name": "churn_reason", "expression": "`churn_reason`"}], "disaggregated": false}}
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "frame": {"title": "Churn reason", "showTitle": true},
              "encodings": {"fields": [
                {"fieldName": "churn_reason", "queryName": "q_reason_exp", "displayName": "Churn reason"},
                {"fieldName": "churn_reason", "queryName": "q_reason_sub"}
              ]}
            }
          },
          "position": {"x": 4, "y": 0, "width": 4, "height": 2}
        },
        {
          "widget": {
            "name": "filter_band",
            "queries": [
              {"name": "q_band_exp", "query": {"datasetName": "ds_exposure", "fields": [{"name": "risk_band", "expression": "`risk_band`"}], "disaggregated": false}},
              {"name": "q_band_sub", "query": {"datasetName": "ds_subscribers", "fields": [{"name": "risk_band", "expression": "`risk_band`"}], "disaggregated": false}}
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "frame": {"title": "Risk band", "showTitle": true},
              "encodings": {"fields": [
                {"fieldName": "risk_band", "queryName": "q_band_exp", "displayName": "Risk band"},
                {"fieldName": "risk_band", "queryName": "q_band_sub"}
              ]}
            }
          },
          "position": {"x": 8, "y": 0, "width": 4, "height": 2}
        }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "canvasBackgroundColor": {"light": "#F5F7FB", "dark": "#0F1419"},
      "widgetBackgroundColor": {"light": "#FFFFFF", "dark": "#161B22"},
      "widgetBorderColor": {"light": "#FFFFFF", "dark": "#161B22"},
      "fontColor": {"light": "#1F2530", "dark": "#E8ECF0"},
      "selectionColor": {"light": "#4F7CE3", "dark": "#8ACAFF"},
      "visualizationColors": ["#094074", "#3C6997", "#5ADBFF", "#FFB020", "#E5484D"],
      "widgetHeaderAlignment": "LEFT"
    },
    "genieSpace": {
      "isEnabled": true,
      "overrideId": "01f1a22b61531adeb4bfa89a5193ef65",
      "enablementMode": "ENABLED"
    }
  }
}
